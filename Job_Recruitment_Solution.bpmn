<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_JobRecruitment" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.49.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:process id="Process_JobRecruitment" name="Job Applicant Recruitment" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Candidate submits application online">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_ScreenApplication" name="Screen application">
      <bpmn:extensionElements><zeebe:taskDefinition type="screen-application" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Eligible" name="Eligible?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Elig_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Elig_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ScheduleTechnical" name="Schedule technical interview">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>Flow_Elig_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_EvaluateTechnical" name="Evaluate technical interview">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_PassedTechnical" name="Passed technical interview?">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_Tech_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Tech_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ScheduleHR" name="Schedule HR / managerial round">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>Flow_Tech_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ConductHR" name="Conduct HR / managerial round">
      <bpmn:extensionElements><zeebe:userTask /></bpmn:extensionElements>
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Selected" name="Selected in HR round?">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_Sel_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Sel_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_GenerateOffer" name="Generate offer letter">
      <bpmn:extensionElements><zeebe:taskDefinition type="generate-offer-letter" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_Sel_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_SendOffer" name="Send offer letter">
      <bpmn:extensionElements><zeebe:taskDefinition type="send-offer-letter" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_OfferSent" name="Offer sent">
      <bpmn:incoming>Flow_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Task_RejectScreening" name="Send rejection notification (screening)">
      <bpmn:extensionElements><zeebe:taskDefinition type="reject-screening" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_Elig_No</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_NotEligible" name="Not eligible">
      <bpmn:incoming>Flow_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Task_RejectTechnical" name="Send rejection notification (technical)">
      <bpmn:extensionElements><zeebe:taskDefinition type="reject-technical" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_Tech_No</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_FailedTechnical" name="Failed technical interview">
      <bpmn:incoming>Flow_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Task_RejectHR" name="Send rejection notification (HR round)">
      <bpmn:extensionElements><zeebe:taskDefinition type="reject-hr-round" /></bpmn:extensionElements>
      <bpmn:incoming>Flow_Sel_No</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_NotSelected" name="Not selected">
      <bpmn:incoming>Flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_ScreenApplication" />
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_ScreenApplication" targetRef="Gateway_Eligible" />
    <bpmn:sequenceFlow id="Flow_Elig_Yes" name="Yes" sourceRef="Gateway_Eligible" targetRef="Task_ScheduleTechnical" />
    <bpmn:sequenceFlow id="Flow_Elig_No" name="No" sourceRef="Gateway_Eligible" targetRef="Task_RejectScreening" />
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_ScheduleTechnical" targetRef="Task_EvaluateTechnical" />
    <bpmn:sequenceFlow id="Flow_4" sourceRef="Task_EvaluateTechnical" targetRef="Gateway_PassedTechnical" />
    <bpmn:sequenceFlow id="Flow_Tech_Yes" name="Yes" sourceRef="Gateway_PassedTechnical" targetRef="Task_ScheduleHR" />
    <bpmn:sequenceFlow id="Flow_Tech_No" name="No" sourceRef="Gateway_PassedTechnical" targetRef="Task_RejectTechnical" />
    <bpmn:sequenceFlow id="Flow_5" sourceRef="Task_ScheduleHR" targetRef="Task_ConductHR" />
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_ConductHR" targetRef="Gateway_Selected" />
    <bpmn:sequenceFlow id="Flow_Sel_Yes" name="Yes" sourceRef="Gateway_Selected" targetRef="Task_GenerateOffer" />
    <bpmn:sequenceFlow id="Flow_Sel_No" name="No" sourceRef="Gateway_Selected" targetRef="Task_RejectHR" />
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_GenerateOffer" targetRef="Task_SendOffer" />
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_SendOffer" targetRef="End_OfferSent" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_RejectScreening" targetRef="End_NotEligible" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_RejectTechnical" targetRef="End_FailedTechnical" />
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_RejectHR" targetRef="End_NotSelected" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_JobRecruitment">
      <bpmndi:BPMNShape id="StartEvent_1_di" bpmnElement="StartEvent_1"><dc:Bounds x="152" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="130" y="225" width="80" height="40" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ScreenApplication_di" bpmnElement="Task_ScreenApplication"><dc:Bounds x="240" y="160" width="100" height="80" /></bpmndi:BPMNShape>
