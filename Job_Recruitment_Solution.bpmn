      <bpmndi:BPMNShape id="Task_ScheduleHR_di" bpmnElement="Task_ScheduleHR"><dc:Bounds x="910" y="160" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ConductHR_di" bpmnElement="Task_ConductHR"><dc:Bounds x="1060" y="160" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Selected_di" bpmnElement="Gateway_Selected" isMarkerVisible="true"><dc:Bounds x="1215" y="175" width="50" height="50" />
        <bpmndi:BPMNLabel><dc:Bounds x="1200" y="130" width="80" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_GenerateOffer_di" bpmnElement="Task_GenerateOffer"><dc:Bounds x="1320" y="160" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendOffer_di" bpmnElement="Task_SendOffer"><dc:Bounds x="1470" y="160" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_OfferSent_di" bpmnElement="End_OfferSent"><dc:Bounds x="1622" y="182" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1610" y="225" width="60" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RejectScreening_di" bpmnElement="Task_RejectScreening"><dc:Bounds x="370" y="300" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_NotEligible_di" bpmnElement="End_NotEligible"><dc:Bounds x="402" y="432" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="390" y="475" width="60" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RejectTechnical_di" bpmnElement="Task_RejectTechnical"><dc:Bounds x="780" y="300" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_FailedTechnical_di" bpmnElement="End_FailedTechnical"><dc:Bounds x="812" y="432" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="790" y="475" width="80" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RejectHR_di" bpmnElement="Task_RejectHR"><dc:Bounds x="1190" y="300" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_NotSelected_di" bpmnElement="End_NotSelected"><dc:Bounds x="1222" y="432" width="36" height="36" />
        <bpmndi:BPMNLabel><dc:Bounds x="1206" y="475" width="68" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1"><di:waypoint x="188" y="200" /><di:waypoint x="240" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2"><di:waypoint x="340" y="200" /><di:waypoint x="395" y="200" /></bpmndi:BPMNEdge>
