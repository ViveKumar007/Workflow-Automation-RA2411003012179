      <bpmndi:BPMNEdge id="Flow_Tech_No_di" bpmnElement="Flow_Tech_No"><di:waypoint x="830" y="225" /><di:waypoint x="830" y="300" />
        <bpmndi:BPMNLabel><dc:Bounds x="838" y="255" width="15" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5"><di:waypoint x="1010" y="200" /><di:waypoint x="1060" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6"><di:waypoint x="1160" y="200" /><di:waypoint x="1215" y="200" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Sel_Yes_di" bpmnElement="Flow_Sel_Yes"><di:waypoint x="1265" y="200" /><di:waypoint x="1320" y="200" />
        <bpmndi:BPMNLabel><dc:Bounds x="1283" y="182" width="18" height="14" /></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Sel_No_di" bpmnElement="Flow_Sel_No"><di:waypoint x="1240" y="225" /><di:waypoint x="1240" y="300" />
